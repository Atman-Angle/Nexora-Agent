{
  "name": "@nexora/runtime",
  "version": "1.1.0",
  "description": "Durable, auditable execution runtime for embeddable AI agents.",
  "type": "module",
  "keywords": [
    "agent",
    "runtime",
    "ai",
    "durable-execution"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atman-Angle/Nexora-Agent.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/Atman-Angle/Nexora-Agent#readme",
  "bugs": {
    "url": "https://github.com/Atman-Angle/Nexora-Agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/execution",
    "dist/store"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  }
}
