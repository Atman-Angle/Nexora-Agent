{
  "name": "@nexora/runtime",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/tool-runtime"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p ../../tsconfig.runtime.json",
    "prepack": "node ../../node_modules/typescript/bin/tsc -p ../../tsconfig.runtime.json"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  }
}
