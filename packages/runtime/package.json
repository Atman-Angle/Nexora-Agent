{
  "name": "@nexora/runtime",
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/context",
    "dist/execution",
    "dist/providers",
    "dist/store",
    "dist/testing"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  }
}
