{
  "name": "@nexora/harness",
  "version": "1.1.0",
  "description": "Provider-neutral agent loop and context harness for Nexora Runtime.",
  "type": "module",
  "keywords": [
    "agent",
    "llm",
    "harness",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atman-Angle/Nexora-Agent.git",
    "directory": "packages/harness"
  },
  "homepage": "https://github.com/Atman-Angle/Nexora-Agent#readme",
  "bugs": {
    "url": "https://github.com/Atman-Angle/Nexora-Agent/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "@nexora/runtime": "workspace:*",
    "better-sqlite3": "12.11.1",
    "zod": "3.25.76"
  }
}
