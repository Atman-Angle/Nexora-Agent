            "input": {
              "path": "index.html",
              "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>个人探索日志</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <h1>个人探索日志</h1>\n      <p class=\"subtitle\">记录每一次好奇、尝试与发现。</p>\n    </header>\n\n    <section class=\"panel\" aria-labelledby=\"form-heading\">\n      <h2 id=\"form-heading\">新增记录</h2>\n      <form id=\"entry-form\" autocomplete=\"off\">\n        <div class=\"field\">\n          <label for=\"entry-title\">标题</label>\n          <input id=\"entry-title\" name=\"title\" type=\"text\" maxlength=\"120\" required\n                 placeholder=\"例如：试着用 CSS 画一个日落\">\n        </div>\n        <div class=\"field\">\n          <label for=\"entry-category\">类别</label>\n          <input id=\"entry-category\" name=\"category\" type=\"text\" list=\"category-options\" maxlength=\"24\"\n                 placeholder=\"例如：技术 / 阅读 / 生活\">\n          <datalist id=\"category-options\"></datalist>\n        </div>\n        <div class=\"field\">\n          <label for=\"entry-content\">正文</label>\n          <textarea id=\"entry-content\" name=\"content\" rows=\"4\"\n                    placeholder=\"做了什么？发现了什么？下一步想试什么？\"></textarea>\n        </div>\n        <div class=\"form-actions\">\n          <button type=\"submit\" id=\"submit-button\">保存记录</button>\n          <button type=\"button\" id=\"cancel-edit-button\" class=\"secondary\" hidden>取消编辑</button>\n        </div>\n        <p id=\"form-error\" class=\"form-error\" role=\"alert\" hidden></p>\n      </form>\n    </section>\n\n    <section class=\"toolbar\" aria-label=\"搜索与筛选\">\n      <div class=\"field search-field\">\n        <label for=\"search-input\">搜索</label>\n        <input id=\"search-input\" type=\"search\" placeholder=\"按标题、正文或类别搜索\">\n      </div>\n      <div class=\"field filter-field\">\n        <label for=\"category-filter\">类别筛选</label>\n        <select id=\"category-filter\">\n          <option value=\"\">全部类别</option>\n        </select>\n      </div>\n      <p id=\"result-count\" class=\"result-count\" aria-live=\"polite\"></p>\n    </section>\n\n    <section aria-labelledby=\"list-heading\">\n      <h2 id=\"list-heading\" class=\"visually-hidden\">记录列表</h2>\n      <ul id=\"entry-list\" class=\"entry-list\"></ul>\n      <p id=\"empty-state\" class=\"empty-state\" hidden>还没有符合条件的记录。</p>\n    </section>\n\n    <template id=\"entry-template\">\n      <li class=\"entry-card\" data-id=\"\">\n        <div class=\"entry-head\">\n          <h3 class=\"entry-title\"></h3>\n          <span class=\"entry-category\"></span>\n        </div>\n        <p class=\"entry-meta\">\n          <time class=\"entry-date\" datetime=\"\"></time>\n          <span class=\"entry-updated\" hidden></span>\n        </p>\n        <p class=\"entry-content\"></p>\n        <div class=\"entry-actions\">\n          <button type=\"button\" class=\"edit-button\">编辑</button>\n          <button type=\"button\" class=\"delete-button secondary\">删除</button>\n        </div>\n      </li>\n    </template>\n  </main>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>\n"
