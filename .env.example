# Nexora CLI — example environment configuration.
# Copy to `.env` (or export in your shell) and fill in real values.
# Do NOT commit real API keys.

# --- Model provider selection ---
# Required: routes requests to an OpenAI-compatible chat/completions endpoint.
NEXORA_MODEL_PROVIDER=openai-compatible

# --- OpenAI-compatible provider ---
# Base URL of the chat/completions endpoint, e.g. https://api.openai.com/v1
NEXORA_MODEL_BASE_URL=
# API key. Treated as a secret: never written to events, logs, or artifacts.
NEXORA_MODEL_API_KEY=
# Model name, e.g. gpt-4o-mini
NEXORA_MODEL_NAME=
# Request timeout in milliseconds (optional, default 60000)
NEXORA_MODEL_TIMEOUT_MS=60000

# --- Runtime paths (required for most commands) ---
# SQLite database path.
NEXORA_DB_PATH=
# Workspace root for filesystem/shell tools.
NEXORA_WORKSPACE_ROOT=
# Artifact storage root (optional; defaults to <db dir>/artifacts).
NEXORA_ARTIFACT_ROOT=
