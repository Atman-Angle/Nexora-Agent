{
  "name": "nexora-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "test:context-quality": "vitest run tests/runtime/e049-plan-authority.test.ts tests/runtime/e080-deterministic-context-eviction.test.ts tests/runtime/e081-structured-compaction.test.ts tests/runtime/e082-rehydration.test.ts tests/runtime/e083-context-branching.test.ts tests/runtime/e087-long-sequence-context-quality.test.ts tests/runtime/e088-decision-continuity-projection.test.ts tests/runtime/e089-checkpoint-integrity.test.ts tests/runtime/e089-multi-cycle-context-continuity.test.ts tests/runtime/e089-context-build-performance.test.ts tests/runtime/e090-deterministic-history-candidates.test.ts tests/runtime/system-validation-context-harness.test.ts --no-file-parallelism",
    "test:runtime-harness-release": "vitest run tests/runtime/e049-completion-integrity.test.ts tests/runtime/e053-tool-capability-approval-contract.test.ts tests/runtime/e065-provider-transient-recovery.test.ts tests/runtime/e081-structured-compaction.test.ts tests/runtime/e084-model-config.test.ts tests/runtime/e089-multi-cycle-context-continuity.test.ts tests/runtime/e093-bounded-memory-recall.test.ts tests/runtime/e095-memory-security-privacy.test.ts tests/runtime/e102-rehydration-action-continuity.test.ts tests/runtime/e106-context-memory-benchmark-v2-stress.test.ts tests/runtime/e110-recovery-reducer.test.ts tests/runtime/e112-durable-crash-matrix.test.ts tests/runtime/e114-context-observation-deduplication.test.ts tests/runtime/e119-progressive-agent-execution.test.ts tests/runtime/system-validation-context-harness.test.ts --no-file-parallelism",
    "test:agent-runtime-parity": "vitest run tests/runtime/e084-model-config.test.ts tests/runtime/e093-bounded-memory-recall.test.ts tests/runtime/e108-runtime-owned-intent-compilation.test.ts tests/runtime/e112-durable-crash-matrix.test.ts tests/runtime/e116-agent-runtime-strategy-parity.test.ts tests/runtime/system-validation-context-harness.test.ts --no-file-parallelism",
    "benchmark:context-memory": "node --import tsx tests/benchmarks/context-memory-harness-v1.ts",
    "benchmark:context-memory:v2": "node --import tsx tests/benchmarks/context-memory-harness-v2.ts",
    "benchmark:context-memory:provider": "node --env-file=.env --import tsx tests/benchmarks/context-memory-provider-v1.ts",
    "canary:context-memory": "node --env-file=.env --import tsx tests/canaries/context-memory-continuity.ts",
    "nexora": "node --import tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "^12.2.0",
    "zod": "^3.25.76"
  }
}
